rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // 1. Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (or only owner/admin)
      allow read: if isAuthenticated();
      // Users can create their own profile upon registration
      allow create: if isOwner(userId);
      // Users can update their name/phone, but regular customers cannot change their role to 'admin'
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Categories collection
    match /categories/{categoryId} {
      // All authenticated users can browse categories
      allow read: if isAuthenticated();
      // Only canteen staff / admin can add, update, or remove categories
      allow create, update, delete: if isAdmin();
    }

    // 3. Foods collection
    match /foods/{foodId} {
      // All authenticated users can view menu foods
      allow read: if isAuthenticated();
      // Only canteen staff / admin can create, update, or delete menu items
      allow create: if isAdmin() &&
                       request.resource.data.price is number &&
                       request.resource.data.price > 0 &&
                       request.resource.data.name is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Orders collection
    match /orders/{orderId} {
      // Customers can read only their own orders; Admins can read all orders
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Customers can place new orders for themselves
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.total is number &&
                       request.resource.data.total >= 0 &&
                       request.resource.data.items is list &&
                       request.resource.data.items.size() > 0 &&
                       // Ensure no sensitive payment credentials (e.g. card number, CVV) are saved
                       !request.resource.data.keys().hasAny(['cardNumber', 'cvv', 'cardExpiry', 'pin']);

      // Status updates: Admins can update any status.
      // Customers can only cancel their own order if it is still in 'Placed' status.
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        resource.data.orderStatus == 'Placed' &&
        request.resource.data.orderStatus == 'Cancelled'
      );

      // Only admins can delete order records
      allow delete: if isAdmin();
    }
  }
}
